bin/
.env
*.exe
*.test
*.out
vendor/
tmp/
frontend/node_modules/
frontend/dist/

# Sortie de `make build-frontend`, copiée ici pour le go:embed. Seul le marqueur
# de répertoire est suivi : garder index.html sous git le faisait réécrire à
# chaque build, salissant l'arbre en permanence.
internal/frontend/dist/*
!internal/frontend/dist/.gitkeep
.DS_Store
.idea/
.vscode/
# Prompts de dev locaux (le reste de .github/ — workflows, etc. — est versionné)
.github/prompts/
*.log
*.cache
*.bak
*.swp
*.swo
send_2000_mails.sh
send_2000_mails_individuel.sh


# Sortie de GoReleaser (build local : goreleaser release --skip=publish)
/dist/
